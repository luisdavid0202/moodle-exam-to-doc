# ──────────────────────────────────────────
# General
# ──────────────────────────────────────────
.DS_Store
*.pem
.env
.env*.local

# ──────────────────────────────────────────
# Frontend (Next.js / Node)
# ──────────────────────────────────────────
frontend/node_modules/
node_modules/
frontend/out/
# matches both legacy root .next/ and frontend/.next/
.next/
frontend/build/
frontend/coverage/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/*.tsbuildinfo
frontend/next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────
# Backend (Python)
# ──────────────────────────────────────────
backend/.venv/
backend/__pycache__/
backend/*.pyc
backend/*.pyo
backend/.pytest_cache/
backend/dist/
backend/*.egg-info/
